{
  "name": "kraftigere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --project demo-kraftigere --only auth,firestore \"node scripts/seed.mjs && vite\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-kraftigere --only firestore \"vitest run tests/rules\"",
    "test:e2e": "playwright test",
    "perf": "playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}

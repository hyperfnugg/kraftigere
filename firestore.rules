rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null &&
             request.auth.token.email in
               get(/databases/$(database)/documents/config/family).data.members;
    }

    match /config/family {
      allow read: if isFamily();
      allow write: if false;
    }

    // The Oda Link: Oda client registration, a sign-in under way, and tokens. Only the Oda
    // functions read and write it, through the Admin SDK. See docs/adr/0005-oda-route.md.
    match /config/odaLink {
      allow read, write: if false;
    }

    // The Entry shape the app writes. See docs/adr/0003-data-shape-changes.md.
    // An Entry is for one Ware and keeps the Ware's name as its text. Added by hand, it
    // comes in the same batch that creates or counts its Ware. Iverksett adds it with the
    // dishes that need it, without counting the Ware, so the rules don't look the Ware up
    // then (a batch may hold many, and rules can only read 20 documents per batch).
    function isNewEntry(data) {
      return data.keys().hasOnly(['text', 'ware', 'checked', 'createdAt', 'note', 'dishes']) &&
             data.keys().hasAll(['text', 'ware', 'checked', 'createdAt']) &&
             (!('note' in data) || isNote(data.note)) &&
             isWareName(data.text) &&
             isWareName(data.ware) &&
             (('dishes' in data && isDishes(data.dishes)) ||
              (!('dishes' in data) &&
               getAfter(/databases/$(database)/documents/wares/$(data.ware)).data.name == data.text)) &&
             data.checked == false &&
             data.createdAt == request.time;
    }

    // The dishes Iverksett added an Entry for. The rules can't loop, so they check that
    // it's a short list but not the shape of each dish.
    function isDishes(dishes) {
      return dishes is list && dishes.size() >= 1 && dishes.size() <= 50;
    }

    // A free-text Note, such as "lots" or "the lactose-free one".
    function isNote(note) {
      return note is string && note.size() >= 1 && note.size() <= 200;
    }

    // An update checks off or unchecks, sets or removes the Note, or adds dishes.
    // Checking off records when; unchecking forgets it.
    function isEntryUpdate(before, after) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['checked', 'checkedAt', 'note', 'dishes']) &&
             (!changed.hasAny(['checked', 'checkedAt']) ||
              (after.checked == true && after.checkedAt == request.time) ||
              (after.checked == false && !('checkedAt' in after))) &&
             (!('note' in after) || isNote(after.note)) &&
             (!changed.hasAny(['dishes']) || isDishes(after.dishes));
    }

    function isWareName(name) {
      return name is string && name.size() >= 1 && name.size() <= 100;
    }

    // A Ware: anything the Family buys. Its id is its normalized name, so names are unique
    // without a query. A hand add creates or counts it, which makes it a Staple. Iverksett
    // creates it without counting an add. usuallyAtHome is remembered from Iverksett, so
    // salt and oil start unticked.
    match /wares/{wareId} {
      allow read: if isFamily();
      allow create: if isFamily() &&
                       request.resource.data.keys().hasOnly(['name', 'addCount', 'lastAddedAt', 'usuallyAtHome']) &&
                       request.resource.data.keys().hasAll(['name', 'addCount']) &&
                       isWareName(request.resource.data.name) &&
                       request.resource.data.get('usuallyAtHome', false) is bool &&
                       ((request.resource.data.addCount == 1 && request.resource.data.lastAddedAt == request.time) ||
                        (request.resource.data.addCount == 0 && !('lastAddedAt' in request.resource.data)));
      // Each add counts once. The name may change to the spelling last added. Iverksett
      // only sets usuallyAtHome.
      allow update: if isFamily() &&
                       ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'addCount', 'lastAddedAt']) &&
                         isWareName(request.resource.data.name) &&
                         request.resource.data.addCount == resource.data.addCount + 1 &&
                         request.resource.data.lastAddedAt == request.time) ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usuallyAtHome']) &&
                         request.resource.data.usuallyAtHome is bool));
    }

    // A remembered match, keyed on an Ingredient's normalized wording: the Ware (by id)
    // that Iverksett matched it to last.
    match /matches/{wordingId} {
      allow read: if isFamily();
      allow create, update: if isFamily() &&
                               request.resource.data.keys().hasOnly(['wording', 'ware']) &&
                               request.resource.data.keys().hasAll(['wording', 'ware']) &&
                               request.resource.data.wording is string &&
                               request.resource.data.wording.size() >= 1 &&
                               request.resource.data.wording.size() <= 200 &&
                               isWareName(request.resource.data.ware);
    }

    match /entries/{entryId} {
      allow read, delete: if isFamily();
      allow create: if isFamily() && isNewEntry(request.resource.data);
      allow update: if isFamily() && isEntryUpdate(resource.data, request.resource.data);
    }

    // Guidelines: one text for the Family. updatedAt is when it last changed, for Outdated.
    match /config/guidelines {
      allow read: if isFamily();
      allow write: if isFamily() &&
                      request.resource.data.keys().hasOnly(['text', 'updatedAt']) &&
                      request.resource.data.keys().hasAll(['text', 'updatedAt']) &&
                      isLongText(request.resource.data.text) &&
                      request.resource.data.updatedAt == request.time;
    }

    function isLongText(text) {
      return text is string && text.size() <= 5000;
    }

    // A week's changed field stamped now, or left alone.
    function stampedIfChanged(changed, field, after) {
      return !changed.hasAny([field]) || after[field] == request.time;
    }

    // A Meal is a list of courses. A day whose Meal changes stamps it in mealsAt, so its
    // Recipes become Outdated.
    function isMealChange(before, after, day) {
      let meal = after.menu[day];
      let mealChanged = before.get('menu', {}).get(day, null) != meal;
      let stampChanged = before.get('mealsAt', {}).get(day, null) != after.mealsAt.get(day, null);
      return meal is list && meal.size() <= 4 &&
             (!(mealChanged || stampChanged) || after.mealsAt.get(day, null) == request.time);
    }

    function isMenu(before, after) {
      let days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
      return after.menu is map && after.menu.keys().hasOnly(days) && after.menu.keys().hasAll(days) &&
             after.mealsAt is map && after.mealsAt.keys().hasOnly(days) &&
             isMealChange(before, after, 'mon') && isMealChange(before, after, 'tue') &&
             isMealChange(before, after, 'wed') && isMealChange(before, after, 'thu') &&
             isMealChange(before, after, 'fri') && isMealChange(before, after, 'sat') &&
             isMealChange(before, after, 'sun');
    }

    // A Day Note. A day whose Note changes stamps it in dayNotesAt.
    function isDayNoteChange(before, after, day) {
      let note = after.dayNotes.get(day, null);
      let noteChanged = before.get('dayNotes', {}).get(day, null) != note;
      let stampChanged = before.get('dayNotesAt', {}).get(day, null) != after.dayNotesAt.get(day, null);
      return (note == null || isLongText(note)) &&
             (!(noteChanged || stampChanged) || after.dayNotesAt.get(day, null) == request.time);
    }

    function isDayNotes(before, after) {
      let days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
      return after.dayNotes is map && after.dayNotes.keys().hasOnly(days) &&
             after.dayNotesAt is map && after.dayNotesAt.keys().hasOnly(days) &&
             isDayNoteChange(before, after, 'mon') && isDayNoteChange(before, after, 'tue') &&
             isDayNoteChange(before, after, 'wed') && isDayNoteChange(before, after, 'thu') &&
             isDayNoteChange(before, after, 'fri') && isDayNoteChange(before, after, 'sat') &&
             isDayNoteChange(before, after, 'sun');
    }

    // A week, by ISO week id like 2026-W44: Day Notes and the Menu. menuAt says when the AI
    // last made the Menu, and confirmedAt when it was Confirmed, which happens once. After
    // that the Ingredients are bought, so the Menu and Day Notes stay as they are.
    // notes, notesAt and accepted are left over from Week Notes and accepting the Menu,
    // and can stay on old weeks but not change.
    function isWeek(before, after) {
      let changed = after.diff(before).affectedKeys();
      return after.keys().hasOnly(['notes', 'notesAt', 'accepted', 'dayNotes', 'dayNotesAt', 'menu', 'menuAt', 'mealsAt', 'confirmedAt']) &&
             (!changed.hasAny(['confirmedAt']) ||
              (!('confirmedAt' in before) && after.confirmedAt == request.time && 'menu' in after)) &&
             (!('confirmedAt' in before) || !changed.hasAny(['menu', 'menuAt', 'mealsAt', 'dayNotes', 'dayNotesAt'])) &&
             !changed.hasAny(['notes', 'notesAt', 'accepted']) &&
             (!('dayNotes' in after) || isDayNotes(before, after)) &&
             ('dayNotes' in after) == ('dayNotesAt' in after) &&
             (!('menu' in after) || isMenu(before, after)) &&
             ('menu' in after) == ('mealsAt' in after) &&
             (!('menuAt' in after) || ('menu' in after && stampedIfChanged(changed, 'menuAt', after)));
    }

    match /weeks/{weekId} {
      allow read: if isFamily();
      allow create: if isFamily() && weekId.matches('^[0-9]{4}-W[0-9]{2}$') &&
                       isWeek({}, request.resource.data);
      allow update: if isFamily() && isWeek(resource.data, request.resource.data);

      // A Recipe for one course of one day's Meal, with id like tue-0. madeAt is when the
      // AI last made it; hand edits leave it alone. The rules can't loop, so they check
      // that steps is a short list but not the shape of each step or its Ingredients.
      function isRecipe(before, after) {
        return after.keys().hasOnly(['course', 'servings', 'steps', 'madeAt']) &&
               after.keys().hasAll(['course', 'servings', 'steps', 'madeAt']) &&
               after.course is string && after.course.size() >= 1 && after.course.size() <= 200 &&
               after.servings is int && after.servings >= 1 && after.servings <= 50 &&
               after.steps is list && after.steps.size() <= 30 &&
               after.madeAt is timestamp &&
               (after.madeAt == request.time || after.madeAt == before.get('madeAt', null));
      }

      match /recipes/{recipeId} {
        allow read, delete: if isFamily();
        allow create: if isFamily() && recipeId.matches('^(mon|tue|wed|thu|fri|sat|sun)-[0-3]$') &&
                         isRecipe({}, request.resource.data);
        allow update: if isFamily() && isRecipe(resource.data, request.resource.data);
      }
    }
  }
}
